# ELQAI environment variables — copy this file to ".env" and fill in real values.
# Never commit the real .env file.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, never exposed to the browser

# --- Anthropic Claude API (analysis engine) ---
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-8"                    # analysis model
# Ensure zero-retention is enabled on this API account/config.

# --- App ---
NEXT_PUBLIC_APP_NAME="ELQAI"
NODE_ENV="development"
