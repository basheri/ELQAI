# ELQAI environment variables — copy this file to ".env" and fill in real values.
# Never commit the real .env file.

# --- Database (Supabase Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, never exposed to the browser

# --- OpenRouter API (analysis engine) ---
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="anthropic/claude-sonnet-4"         # analysis model (OpenRouter model id)

# --- App ---
NEXT_PUBLIC_APP_NAME="ELQAI"
NODE_ENV="development"
